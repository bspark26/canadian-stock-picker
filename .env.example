# Optional. Without this secret, the scanner uses its sourced rules summaries.
# GitHub: Settings > Secrets and variables > Actions > New repository secret.
# Never prefix API keys with VITE_ or put them in public/data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# For a project Pages URL such as https://owner.github.io/canadian-stock-picker/
# The deployment workflow supplies this automatically.
VITE_BASE_PATH=/
